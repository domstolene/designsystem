{
  "name": "@norges-domstoler/dds-components",
  "version": "24.3.1",
  "description": "React components used in Elsa - domstolenes designsystem",
  "author": "Elsa team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/domstolene/designsystem"
  },
  "sideEffects": [
    "*.css",
    "src/styles/index.ts"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./index.css": "./dist/index.css"
  },
  "homepage": "https://design.domstol.no",
  "scripts": {
    "test": "vitest run",
    "test:ui": "vitest --ui --coverage",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "generate-css-types": "tcm src",
    "prebuild": "node scripts/generate-dds-tokens-css.mjs",
    "build": "pnpm generate-css-types && tsdown --config-loader unrun --dts",
    "dev": "pnpm generate-css-types && tsdown  --config-loader unrun --dts && pnpm generate-css-types --watch",
    "typecheck": "tsc --noEmit",
    "generate:component-template": "ts-node scripts/generate-component-template.ts"
  },
  "keywords": [
    "dds",
    "design",
    "tokens",
    "design tokens",
    "design system",
    "domstolene",
    "norges domstoler",
    "elsa"
  ],
  "devDependencies": {
    "@internationalized/date": "^3.12.3",
    "@norges-domstoler/dds-design-tokens": "workspace:*",
    "@norges-domstoler/storybook-components": "workspace:*",
    "@react-types/datepicker": "^3.14.0",
    "@types/node": "^26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "csstype": "3.2.3",
    "postcss": "^8.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-node": "^10.9.2",
    "typed-css-modules": "^0.9.1"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.12.3",
    "@norges-domstoler/dds-design-tokens": "^10",
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@react-aria/button": "^3.15.1",
    "@react-aria/calendar": "^3.10.1",
    "@react-aria/datepicker": "^3.17.1",
    "@react-aria/focus": "^3.22.1",
    "@react-aria/i18n": "^3.13.1",
    "@react-stately/calendar": "^3.10.1",
    "@react-stately/datepicker": "^3.17.1",
    "file-selector": "^5.0.1",
    "react-select": "^5.10.2"
  },
  "publishConfig": {
    "provenance": true
  }
}
