{
  "name": "@norges-domstoler/dds-design-tokens",
  "version": "10.1.0",
  "description": "Design tokens used in Domstolenes designsystem",
  "author": "DDS team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/domstolene/designsystem"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": "./*"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "homepage": "https://design.domstol.no",
  "keywords": [
    "dds",
    "design",
    "tokens",
    "design tokens",
    "design system",
    "domstolene",
    "norges domstoler",
    "elsa"
  ],
  "scripts": {
    "clean": "rm -r dist || :",
    "build": "tsdown  --config-loader unrun --dts",
    "build:fast": "tsdown  --config-loader unrun",
    "dev": "pnpm build:fast -- --watch",
    "generate:tokens": "node build.js"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@tokens-studio/sd-transforms": "^2.0.3",
    "style-dictionary": "^5.5.2"
  },
  "publishConfig": {
    "provenance": true
  }
}
